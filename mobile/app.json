{
  "expo": {
    "name": "Khushi Points",
    "slug": "khushi-points",
    "scheme": "khushipoints",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.khushipoints",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.khushipoints",
      "adaptiveIcon": {
        "backgroundColor": "#F0475A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#F0475A"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#F0475A"
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://dhynxoxhbgnwxfhjrraf.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRoeW54b3hoYmdud3hmaGpycmFmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMyMDc1MDIsImV4cCI6MjEwODc4MzUwMn0.hlOE32BrGWFGuIgdBY62htj30GV8pDLZ1uRosd_fLuo",
      "googleSignIn": false,
      "appleSignIn": false,
      "router": {},
      "eas": {
        "projectId": "0eeafdc5-f73d-47dd-a543-593d0beac886"
      }
    },
    "owner": "varun-velichetis-team"
  }
